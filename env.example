# Copy this file to .env and fill in real values locally. Never commit .env.

# Database (defaults to local SQLite if unset)
# For hosted Postgres (e.g. Supabase free tier):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./zomato_notes.db

# Token required in the x-token header for DELETE /notes/{id}
NOTES_DELETE_TOKEN=super-secret-token

# Part 3 AI service
# MOCK_AI=1 -> deterministic offline mock (default, graded baseline, no key needed)
# MOCK_AI=0 -> real path via Groq's free-tier API (requires GROQ_API_KEY)
MOCK_AI=1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant